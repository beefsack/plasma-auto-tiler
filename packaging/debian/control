 cmake, extra-cmake-modules (>= 6.24), qt6-base-dev,
 libkf6config-dev, libkf6coreaddons-dev, libkf6kcmutils-dev,
 libkf6i18n-dev, libkf6widgetsaddons-dev
Standards-Version: 4.7.2
