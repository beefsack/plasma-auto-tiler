{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/plasma-auto-tiler/floor-ratio-static-contract-fixture-v2.schema.json",
  "title": "Floor ratio static-contract-fixture, not runtime/live evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "evidence_status", "proof_executed", "evidence_authenticity", "schema_version", "nonce", "private_roots", "static_execution", "vectors", "future_live_requirements", "future_live_evidence_shape", "operation_allowlist", "cleanup_order", "retention"],
  "properties": {
    "artifact_type": { "const": "static-contract-fixture" },
    "evidence_status": { "const": "not-live-evidence" },
    "proof_executed": { "const": false },
    "evidence_authenticity": { "const": "not-asserted" },
    "schema_version": { "const": "floor-ratio-static-contract-fixture-v2" },
    "nonce": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$" },
    "private_roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "base", "evidence", "xdg_config_home", "xdg_data_home", "xdg_runtime_dir", "wayland_socket", "session_bus"],
      "properties": {
        "status": { "const": "declared-static-path-shape-only" },
        "base": { "type": "string", "pattern": "^/" },
        "evidence": { "type": "string", "pattern": "^/" },
        "xdg_config_home": { "type": "string", "pattern": "^/" },
        "xdg_data_home": { "type": "string", "pattern": "^/" },
        "xdg_runtime_dir": { "type": "string", "pattern": "^/" },
        "wayland_socket": { "type": "string", "pattern": "^/" },
        "session_bus": { "type": "string", "pattern": "^/" }
      }
    },
    "static_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_executed", "live_execution", "attempt_maximum", "attempts_used"],
      "properties": {
        "proof_executed": { "const": false },
        "live_execution": { "const": false },
        "attempt_maximum": { "const": 1 },
        "attempts_used": { "const": 0 }
      }
    },
    "vectors": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "allOf": [
        { "contains": { "type": "object", "properties": { "case": { "const": "single-ancestor-write" } }, "required": ["case"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "case": { "const": "multi-ancestor-writes" } }, "required": ["case"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "case": { "const": "impossible-allocation-retaining-current-fallback" } }, "required": ["case"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "case": { "const": "post-write-mismatch-refusal" } }, "required": ["case"] }, "minContains": 1, "maxContains": 1 }
      ],
      "items": { "$ref": "#/$defs/vector" }
    },
    "future_live_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kwin_version", "child_processes", "layout", "socket", "xdg_isolation", "timeout", "journal_scope", "persistence", "cleanup_order", "command_allowlist", "vector_cases", "proof_authorization", "dependency_capability_check"],
      "properties": {
        "kwin_version": { "const": "6.7.4" },
        "child_processes": { "const": 1 },
        "layout": { "const": "fixed-disposable-custom-tile" },
        "socket": { "const": "absolute-parent-wayland-socket" },
        "xdg_isolation": { "const": "private-xdg-homes-runtime-session-bus" },
        "timeout": { "const": "bounded" },
        "journal_scope": { "const": "fresh-cursor-same-child-pid-project-logs" },
        "persistence": { "const": "host-kwinrc-hash-mtime-before-after-private-persistence" },
        "cleanup_order": { "const": ["stop-child", "restore-persistence", "remove-private-roots", "retain-evidence"] },
        "command_allowlist": { "const": ["kwin_wayland", "busctl", "journalctl", "sha256sum", "stat", "timeout", "mkdir", "mktemp", "rm", "printf"] },
        "vector_cases": { "const": ["single-ancestor-write", "multi-ancestor-writes", "impossible-allocation-retaining-current-fallback", "post-write-mismatch-refusal"] },
        "proof_authorization": { "const": "separate-user-authorization-required" },
        "dependency_capability_check": { "const": "must-be-checked-by-authorized-live-run" }
      }
    },
    "future_live_evidence_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required_capture_fields", "authenticity_requirement"],
      "properties": {
        "status": { "const": "shape-and-requirements-only" },
        "required_capture_fields": { "const": ["runtime_capture_hashes", "child_pid_identity", "child_process_count", "journal_cursor", "journal_scope", "persistence_hash_before_after", "persistence_mtime_before_after", "private_roots"] },
        "authenticity_requirement": { "const": "must-be-established-by-separately-authorized-live-run" }
      }
    },
    "operation_allowlist": {
      "const": ["fresh-decode:baseline:current-fallback", "plan:ancestor-1", "plan:ancestor-2", "plan:allocation", "write:ancestor-1", "write:ancestor-2", "fresh-decode:after-write:ancestor-1:ratio-1-2", "fresh-decode:after-write:ancestor-1:mismatch", "fresh-decode:after-write:ancestor-2:ratio-1-3", "fallback-retained:current-fallback", "refuse:no-split-no-reverse-write", "stop-reason:vector-complete", "stop-reason:impossible-allocation", "stop-reason:post-write-mismatch", "cleanup:stop-child", "cleanup:restore-persistence", "cleanup:remove-private-roots", "cleanup:retain-evidence"]
    },
    "cleanup_order": { "const": ["stop-child", "restore-persistence", "remove-private-roots", "retain-evidence"] },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_on_static_failure", "evidence_on_interruption", "private_roots_removed_after_retention"],
      "properties": {
        "evidence_on_static_failure": { "const": true },
        "evidence_on_interruption": { "const": true },
        "private_roots_removed_after_retention": { "const": true }
      }
    }
  },
  "$defs": {
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "fresh_decode_sequence", "plans", "writes", "operation_trace", "result", "stop_reason"],
      "properties": {
        "case": { "enum": ["single-ancestor-write", "multi-ancestor-writes", "impossible-allocation-retaining-current-fallback", "post-write-mismatch-refusal"] },
        "fresh_decode_sequence": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^decode-(before|after-[a-z0-9-]+)$" } },
        "plans": { "type": "array", "items": { "$ref": "#/$defs/plan" } },
        "writes": { "type": "array", "items": { "$ref": "#/$defs/write" } },
        "operation_trace": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "result": { "enum": ["planned", "fallback-retained", "refused"] },
        "stop_reason": { "enum": ["vector-complete", "impossible-allocation", "post-write-mismatch", "interrupted"] }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "operation", "value"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["write", "allocate", "split"] },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "value", "decode_after"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "decode_after": { "type": "string", "pattern": "^decode-after-[a-z0-9-]+$" }
      }
    }
  }
}
