        <item>
         <widget class="QLabel" name="shortcutDescription">
          <property name="text">
           <string>Focus-right takes Meta+L; Apply moves Lock Session to Meta+Esc. Settings Apply never changes shortcuts; use these buttons with confirmation. Finish Apply and Restore appear only for an interrupted apply. Force Apply and Cancel appear only for a confirmed clear-row mismatch preview.</string>
          </property>
